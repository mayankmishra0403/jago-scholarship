# Supabase
VITE_SUPABASE_URL=https://iizaefpmeobuolwfljtn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ocgyrx5FzPLJMDPXz5jm_A_h_3Ep3Hy

# Build-time feature flags
# Enables the "view as" role switcher used during the SIH demo
VITE_DEV_ROLE_SWITCH=true
# Enables the simulator panel (inject connector failures / mismatches)
VITE_DEV_SIMULATOR=true

# Aadhaar verification
#
# A non-empty value switches the Aadhaar screen from the simulator to the live
# gateway. It must point at OUR endpoint, which forwards to UIDAI:
#   VITE_UIDAI_GATEWAY_URL=/api/identity/aadhaar
#
# UIDAI partner credentials are deliberately NOT in this file. Anything with a
# VITE_ prefix is inlined into the JavaScript bundle and served to every
# visitor, so a secret behind that prefix is a published secret. The endpoint
# reads them from server-side variables at request time:
#   UIDAI_GATEWAY_URL     https://auth.uidai.gov.in/v2/aadhaar/auth
#   UIDAI_CLIENT_ID       issued under the partner agreement
#   UIDAI_CLIENT_SECRET   issued under the partner agreement
# See README.md.
VITE_UIDAI_GATEWAY_URL=
